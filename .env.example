# LLM Configuration Options
# Choose ONE of the following two options:

# OPTION 1: Use OpenRouter (supports many free models)
# Get a free API key at https://openrouter.ai/keys
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
# Popular free models available via OpenRouter:
#   anthropic/claude-sonnet-4.5
#   anthropic/claude-3.5-sonnet
#   google/gemini-2.0-flash-exp:free
#   deepseek/deepseek-chat
#   kr/glm-5
#   nvidia/nemotron-3-ultra-550b-a55b
LLM_MODEL=stealth/ox-alpha  # Change to any model available on OpenRouter

# OPTION 2: Use Anthropic directly (requires paid key)
# Get your key at https://console.anthropic.com/
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here
# LLM_MODEL=claude-sonnet-4-20250514  # or your preferred Claude model

# Fuzzing configuration (shared)
FUZZ_TIMEOUT_S=300
MAX_RETRIES=3
TEMPLATE_CONFIDENCE_THRESHOLD=0.8